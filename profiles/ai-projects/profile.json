{
  "id": "ai-projects",
  "name": "AI Open Source Projects",
  "display_names": {
    "zh": "AI 开源项目",
    "en": "AI Open Source Projects"
  },
  "match": "match.md",
  "analysis": "analysis.md",
  "content": {
    "analysis_max_chars": 2000,
    "enrichment_max_chars": 8000,
    "sampling": "prefix"
  },
  "enrichment": {
    "prompt": "enrichment.md",
    "blocks": [
      {
        "id": "summary",
        "type": "section",
        "tools": [],
        "primary": true
      },
      {
        "id": "problem_solved",
        "type": "section",
        "tools": []
      },
      {
        "id": "background",
        "type": "section",
        "tools": ["web_search"]
      }
    ]
  }
}
